# SignalLens 后端
SIGNALLENS_ENV=development
SIGNALLENS_DATABASE_URL=sqlite:///./data/signallens.db
SIGNALLENS_WEB_ORIGIN=http://localhost:5173

# OpenAI-compatible 模型；未配置时 Worker 不会消费分析任务
SIGNALLENS_LLM_BASE_URL=https://api.openai.com/v1
SIGNALLENS_LLM_API_KEY=
SIGNALLENS_LLM_MODEL=
# auto 会为 api.deepseek.com 使用 json_object，其他服务使用 json_schema
SIGNALLENS_LLM_RESPONSE_FORMAT=auto
SIGNALLENS_LLM_MAX_TOKENS=8192
